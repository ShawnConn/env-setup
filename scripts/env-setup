#!/usr/bin/env bash

# Set stop on error / enable debug
set -euo pipefail

############################################################################
# ENVSETUP
############################################################################

##{{{#######################################################################
############################################################################
# FUNCTIONS
############################################################################

# Config env-setup
# $1: The config setup to use for env-setup (see $OPTIONS)
config() {
    ENVSETUP_CONFIG_MSG="Select an env-setup config (enter q to quit):"
    CONFIG=${1:-""}
    CFILE="$INSTALL_DIR/config.yml"
    CONFIG_TYPE=""

    if [[ -f "$CFILE" ]]; then
        if [[ -L "$CFILE" ]]; then
            # shellcheck disable=SC2012
            FILE="$(ls -l "$CFILE" | cut -d'>' -f2 | xargs)"
            FILE="$(basename "$FILE")"
            # shellcheck disable=SC2001
            CONFIG_TYPE=$(echo "$FILE" | sed 's/.\(.*\).config.yml/\1/')
        else
            CONFIG_TYPE="custom"
        fi
    else
        CONFIG_TYPE="default"
    fi

    echo -e "${C_SUC}Config currently set to ${C_WAR}$CONFIG_TYPE${C_RES}"
    echo -e "${C_SUC}$ENVSETUP_CONFIG_MSG${C_RES}\n"
    if [[ -z "$CONFIG" ]]; then
        OPTIONS="none mini default most custom"
        select CONFIG in $OPTIONS; do
            break
        done
    fi

    if [[ -z "$CONFIG" ]]; then
        echo -e "${C_WAR}Quit${C_RES}\n"
        exit 0
    fi
    if [[ "$CONFIG" == "custom" ]]; then
        if [[ -f "$CFILE" ]]; then
            rm "$CFILE"
        fi
        echo -e "${C_SUC}Select starter for custom config:${C_RES}\n"
        OPTIONS="none mini default most"
        select CONFIG in $OPTIONS; do
            cp "$INSTALL_DIR/.$CONFIG.config.yml" "$CFILE"
            break
        done
        echo -e "${C_SUC}Starter custom config set${C_RES}"
    else
        if [[ -f "$CFILE" ]]; then
            rm "$CFILE"
        fi
        if [[ "$CONFIG" != "default" ]]; then
            ln -s "$INSTALL_DIR/.$CONFIG.config.yml" "$CFILE"
        fi
        echo -e "${C_SUC}Config set to ${C_WAR}$CONFIG${C_RES}"
    fi
}

# Export env-setup
# $1: The playbook to export config for (default: "all")
xport() {
    # @TODO: func refactor
    REQUIRED_CMDS=(jq yq)
    MISSING=()
    for _cmd in "${REQUIRED_CMDS[@]}"; do
        if ! command -v "$_cmd" >/dev/null 2>&1; then
            MISSING+=("$_cmd")
        fi
    done

    if [[ ${#MISSING[@]} -gt 0 ]]; then
        echo -e "${C_ERR}Missing required tools:${C_RES} " \
            "${C_WAR}$(printf '%s ' "${MISSING[@]}")${C_RES}"
        if [[ "${ENVSETUP_OS:-}" =~ darwin* ]]; then
            echo -e "Install with: brew install ${MISSING[*]}"
            echo -e "Install with your distro package manager" \
            "(apt/yum/pacman) or use pip/snap for yq."
        else
            echo -e "Install with your distro package manager" \
            "(apt/yum/pacman) or use pip/snap for yq."
        fi
        exit 1
    fi

    CFILE="$INSTALL_DIR/config.yml"
    CFILE_BAK="$INSTALL_DIR/.backup.config.yml"
    YQV=$(yq --version | grep --color=none -oE '([0-9]+)\.([0-9]+)\.([0-9]+)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?' | xargs)
    cp "$CFILE" "$CFILE_BAK"
    echo -e "${C_SUC}yq version: ${C_WAR}$YQV${C_RES}"
    echo -e "${C_SUC}Backup config: ${C_WAR}$CFILE_BAK${C_RES}"

    # Check arg for playbook
    PLAYBOOK=${1:-"all"}
    echo -e "${C_SUC}Exporting playbook config: ${C_WAR}$PLAYBOOK${C_RES}\n"
    case "$PLAYBOOK" in
        01-config)
            echo -e "${C_HIL}Exporting 01-config...${C_RES}\n"

            # Retrieve destinations from config
            PUB_DEST=$(yq eval '.pub_dotfiles_repo_local_destination' "$CFILE" | sed "s|~|$HOME|g")
            PRV_DEST=$(yq eval '.prv_dotfiles_repo_local_destination' "$CFILE" | sed "s|~|$HOME|g")

            # Resolve absolute paths using python for cross-platform compatibility
            PUB_DEST_ABS=""
            if [[ -n "$PUB_DEST" && "$PUB_DEST" != "null" ]]; then
                 PUB_DEST_ABS=$(python3 -c "import os, sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))" "$PUB_DEST")
            fi

            PRV_DEST_ABS=""
            if [[ -n "$PRV_DEST" && "$PRV_DEST" != "null" ]]; then
                 PRV_DEST_ABS=$(python3 -c "import os, sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))" "$PRV_DEST")
            fi

            # Check if at least one destination is valid
            if [[ -z "$PUB_DEST_ABS" && -z "$PRV_DEST_ABS" ]]; then
                echo -e "${C_WAR}No valid dotfiles destinations found in config.${C_RES}"
            else
                if [[ -n "$PUB_DEST_ABS" && -d "$PUB_DEST_ABS" ]]; then
                    echo -e "${C_SUC}Scanning for public dotfiles in: ${C_WAR}$PUB_DEST_ABS${C_RES}"
                fi
                if [[ -n "$PRV_DEST_ABS" && -d "$PRV_DEST_ABS" ]]; then
                     echo -e "${C_SUC}Scanning for private dotfiles in: ${C_WAR}$PRV_DEST_ABS${C_RES}"
                fi

                # Initialize arrays
                PUB_FILES=()
                PUB_SUBDIRS=()
                PRV_FILES=()
                PRV_SUBDIRS=()

                # Find symlinks in HOME (depth 3 to catch .config/foo/bar)
                # Exclude Library to avoid macOS system files
                while IFS= read -r -d '' SYMLINK; do
                    # Resolve target
                    TARGET=$(python3 -c "import os, sys; print(os.path.realpath(sys.argv[1]))" "$SYMLINK")
                    REL_PATH=${SYMLINK#$HOME/}

                    # Check Public
                    if [[ -n "$PUB_DEST_ABS" && "$TARGET" == "$PUB_DEST_ABS"* ]]; then
                        if [[ -d "$TARGET" ]]; then
                            PUB_SUBDIRS+=("~/$REL_PATH")
                        elif [[ -f "$TARGET" ]]; then
                            PUB_FILES+=("$REL_PATH")
                        fi
                    # Check Private
                    elif [[ -n "$PRV_DEST_ABS" && "$TARGET" == "$PRV_DEST_ABS"* ]]; then
                         if [[ -d "$TARGET" ]]; then
                            PRV_SUBDIRS+=("~/$REL_PATH")
                        elif [[ -f "$TARGET" ]]; then
                            PRV_FILES+=("$REL_PATH")
                        fi
                    fi
                done < <(find "$HOME" -maxdepth 3 -type l -not -path "*/Library/*" -not -path "*/.Trash/*" -print0)

                # Update Public
                if [[ -n "$PUB_DEST_ABS" ]]; then
                     if [[ ${#PUB_FILES[@]} -gt 0 ]]; then
                        FILES_JSON=$(printf '%s\n' "${PUB_FILES[@]}" | sort | jq -R . | jq -s -c .)
                    else
                        FILES_JSON="[]"
                    fi
                    yq -i ".pub_dotfiles_files = $FILES_JSON" "$CFILE"
                    echo -e "${C_SUC}Updated ${C_WAR}pub_dotfiles_files${C_SUC} with ${C_WAR}${#PUB_FILES[@]}${C_SUC} items${C_RES}"

                    if [[ ${#PUB_SUBDIRS[@]} -gt 0 ]]; then
                        SUBDIRS_JSON=$(printf '%s\n' "${PUB_SUBDIRS[@]}" | sort | jq -R . | jq -s -c .)
                    else
                        SUBDIRS_JSON="[]"
                    fi
                    yq -i ".pub_dotfiles_subdirs = $SUBDIRS_JSON" "$CFILE"
                    echo -e "${C_SUC}Updated ${C_WAR}pub_dotfiles_subdirs${C_SUC} with ${C_WAR}${#PUB_SUBDIRS[@]}${C_SUC} items${C_RES}"
                fi

                # Update Private
                if [[ -n "$PRV_DEST_ABS" ]]; then
                     if [[ ${#PRV_FILES[@]} -gt 0 ]]; then
                        FILES_JSON=$(printf '%s\n' "${PRV_FILES[@]}" | sort | jq -R . | jq -s -c .)
                    else
                        FILES_JSON="[]"
                    fi
                    yq -i ".prv_dotfiles_files = $FILES_JSON" "$CFILE"
                    echo -e "${C_SUC}Updated ${C_WAR}prv_dotfiles_files${C_SUC} with ${C_WAR}${#PRV_FILES[@]}${C_SUC} items${C_RES}"

                    if [[ ${#PRV_SUBDIRS[@]} -gt 0 ]]; then
                        SUBDIRS_JSON=$(printf '%s\n' "${PRV_SUBDIRS[@]}" | sort | jq -R . | jq -s -c .)
                    else
                        SUBDIRS_JSON="[]"
                    fi
                    yq -i ".prv_dotfiles_subdirs = $SUBDIRS_JSON" "$CFILE"
                    echo -e "${C_SUC}Updated ${C_WAR}prv_dotfiles_subdirs${C_SUC} with ${C_WAR}${#PRV_SUBDIRS[@]}${C_SUC} items${C_RES}"
                fi
            fi
            ;;
        02-cli)
            echo -e "${C_HIL}Exporting 02-cli...${C_RES}\n"

            INSTALLED_TAPS=$(brew tap)
            COUNT="$(echo "$INSTALLED_TAPS" | wc -l | xargs)"
            TAPS="$(jq -c -Rs '[split("\n") | .[] | select(length > 0)]' <<< "$INSTALLED_TAPS")"
            yq -i ".homebrew_taps = ${TAPS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}homebrew_taps${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_PACKAGES=$(brew list --formulae | grep -v '^\s*$')
            COUNT="$(echo "$INSTALLED_PACKAGES" | wc -l | xargs)"
            PACKAGES="$(jq -c -Rs '[split("\n") | .[] | select(length > 0)]' <<< "$INSTALLED_PACKAGES")"
            yq -i ".envsetup_homebrew_installed_packages = ${PACKAGES}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}envsetup_homebrew_installed_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            ;;
        03-apps)
            echo -e "${C_HIL}Exporting 03-apps...${C_RES}\n"

            INSTALLED_CASKS=$(brew list --casks | grep -v '^\s*$')
            COUNT="$(echo "$INSTALLED_CASKS" | wc -l | xargs)"
            CASKS="$(jq -c -Rs '[split("\n") | .[] | select(length > 0)]' <<< "$INSTALLED_CASKS")"
            yq -i ".envsetup_homebrew_cask_apps = ${CASKS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}envsetup_homebrew_cask_apps${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            #@TODO: mas_installed_apps|mas_uninstalled_apps
            #brew bundle dump --file=- | sed -n '/^mas/p'
            #@TODO: configure_dock | dockitems_persist | dockitems_remove
            #@TODO: envsetup_apps_macos_settings | envsetup_apps_macos_sudo_settings | envsetup_apps_macos_app_open:

            # DOCK
            # defaults read com.apple.dock persistent-apps | grep file-label | sed 's/.*file-label = "\(.*\)"\;/Name: /g'
            # defaults read com.apple.dock persistent-apps | grep file-label | sed 's/.*file-label = "\(.*\)"\;/Name: /g' | awk '{print "Order: " NR, $0}'

            ;;
        04-packages)
            echo -e "${C_HIL}Exporting 04-packages...${C_RES}\n"

            INSTALLED_CRATES=$(cargo install --list  | awk '{print $1}' | uniq )
            COUNT="$(echo "$INSTALLED_CRATES" | wc -l | xargs)"
            CRATES="$(echo "$INSTALLED_CRATES" | xargs -I {} echo '{"name": "{}"}' | jq -cs '.')"
            yq -i ".cargo_packages = ${CRATES}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}cargo_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_COMPOSER_PLUGINS=$(jq -r '.config."allow-plugins" | keys[]' "$(composer global config home 2> /dev/null)/composer.json")
            COUNT="$(echo "$INSTALLED_COMPOSER_PLUGINS" | wc -l | xargs)"
            PLUGINS="$(jq -R '{name: .}' <<< "$INSTALLED_COMPOSER_PLUGINS" | jq -sc)"
            yq -i ".composer_plugins = ${PLUGINS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}composer_plugins${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_COMPOSER_PACKAGES=$(jq -r '.require | keys[]' "$(composer global config home 2> /dev/null)/composer.json")
            COUNT="$(echo "$INSTALLED_COMPOSER_PACKAGES" | wc -l | xargs)"
            PACKAGES="$(jq -R '{name: .}' <<< "$INSTALLED_COMPOSER_PACKAGES" | jq -sc)"
            yq -i ".composer_packages = ${PACKAGES}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}composer_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_GOBINS="$(for bin in $(go env GOPATH)/bin/*; do printf "%s\n" "$(go version -m $bin | awk '$1 == "path" {print $2}' | sed 's/$/@latest/')"; done)"
            COUNT="$(echo "$INSTALLED_GOBINS" | wc -l | xargs)"
            GOBINS="$(echo "$INSTALLED_GOBINS" | xargs -I {} echo '{"name": "{}"}' | jq -cs '.')"
            yq -i ".go_packages = ${GOBINS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}go_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_GEMS=$(gem list | sed 's/ (.*//')
            COUNT="$(echo "$INSTALLED_GEMS" | wc -l | xargs)"
            GEMS="$(jq -R '{name: .}' <<< "$INSTALLED_GEMS" | jq -sc)"
            yq -i ".gem_packages = ${GEMS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}gem_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_NPM_PACKAGES=$(npm list -g --depth=0 --parseable --silent 2>/dev/null | xargs -I {} basename {})
            COUNT="$(echo "$INSTALLED_NPM_PACKAGES" | wc -l | xargs)"
            NPM_PACKAGES="$(echo "$INSTALLED_NPM_PACKAGES" | xargs -I {} echo '{"name": "{}"}' | jq -cs '.')"
            yq -i ".npm_packages = ${NPM_PACKAGES}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}npm_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"

            INSTALLED_PIPS=$(pipx list --short | sed 's/ .*//')
            COUNT="$(echo "$INSTALLED_PIPS" | wc -l | xargs)"
            PIPS="$(jq -R '{name: .}' <<< "$INSTALLED_PIPS" | jq -sc)"
            yq -i ".pip_packages = ${PIPS}" "$CFILE"
            echo -e "${C_SUC}Updated ${C_WAR}pip_packages${C_SUC} with ${C_WAR}$COUNT${C_SUC} items${C_RES}"
            #@TOOD: capture version

            ;;
        05-repos)
            echo -e "${C_HIL}Exporting 05-repos...${C_RES}\n"

            GIT_REPO_DIR=$(yq eval '.git_repo_project_dir' "$CFILE" \
                | sed "s|~|$HOME|g")

            if [[ ! -d "$GIT_REPO_DIR" ]]; then
                echo -e "${C_WAR}Git repo directory not found: " \
                    "$GIT_REPO_DIR${C_RES}"
            else
                echo -e "${C_SUC}Scanning for git repos in: " \
                    "${C_WAR}$GIT_REPO_DIR${C_RES}"

                # Build JSON array of repo objects
                REPO_JSON="[]"

                # Find all subdirectories containing .git
                while IFS= read -r -d '' REPO_PATH; do
                    REPO_DIR=$(dirname "$REPO_PATH")
                    REPO_NAME=$(basename "$REPO_DIR")

                    echo -e "  Found repo: ${C_HIL}$REPO_NAME${C_RES}"

                    # Get origin URL
                    ORIGIN_URL=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "")

                    # Get other remotes (excluding origin)
                    UPSTREAM_URL=""
                    while IFS= read -r REMOTE_NAME; do
                        if [[ "$REMOTE_NAME" != "origin" && -n "$REMOTE_NAME" ]]; then
                            UPSTREAM_URL=$(git -C "$REPO_DIR" remote get-url "$REMOTE_NAME" 2>/dev/null || echo "")
                            break
                        fi
                    done < <(git -C "$REPO_DIR" remote 2>/dev/null)

                    # Build repo object
                    REPO_OBJ=$(jq -n \
                        --arg name "$REPO_NAME" \
                        --arg url "$ORIGIN_URL" \
                        --arg upstream "$UPSTREAM_URL" \
                        '{name: $name, url: $url, upstream: $upstream}')

                    # Add to array
                    REPO_JSON=$(jq --argjson obj "$REPO_OBJ" '. + [$obj]' <<< "$REPO_JSON")

                done < <(find "$GIT_REPO_DIR" -maxdepth 2 -type d -name ".git" -print0)

                # Update "$CFILE" with the repo array
                if [[ "$REPO_JSON" != "[]" ]]; then
                    yq -i ".git_repo_projects = $REPO_JSON" "$CFILE"
                    echo -e "${C_SUC}Updated $CFILE with $(jq 'length' <<< "$REPO_JSON") repos${C_RES}"
                else
                    echo -e "${C_WAR}No git repos found${C_RES}"
                fi
            fi
            ;;
        06-os)
            echo -e "${C_HIL}Exporting 06-os...${C_RES}\n"
            # @TODO: Add OS export logic
            #
            # envsetup_os_hostname
            # envsetup_os_avatar_url
            # envsetup_os_macos_config_script
            # envsetup_os_macos_settings
            # envsetup_os_macos_sudo_settings
            # envsetup_os_linux_settings

            ;;
        07-cloud)
            echo -e "${C_HIL}Exporting 07-cloud...${C_RES}\n"
            # @TODO: Add cloud export logic
            #
            # envsetup_cloud_app
            # envsetup_cloud_dir
            # envsetup_cloud_backup_dir
            # envsetup_cloud_sync_script
            # envsetup_cloud_project_root
            # envsetup_cloud_project_list
            # envsetup_cloud_project_dirs
            # envsetup_cloud_project_symlink

            ;;
        08-prefs)
            echo -e "${C_HIL}Exporting 08-prefs...${C_RES}\n"
            # @TODO: Prefs export logic here
            #
            # envsetup_prefs_macos_other_dockitems_persist
            # envsetup_prefs_macos_other_dockitems_remove
            # envsetup_prefs_macos_file_extension_handlers
            # envsetup_prefs_macos_login_items
            # envsetup_prefs_macos_settings
            # envsetup_prefs_macos_sudo_settings
            # envsetup_prefs_macos_app_open
            # envsetup_prefs_visual_studio_code_extensions
            # envsetup_prefs_visual_studio_code_extensions_absent

            # defaults read com.apple.dock persistent-others | grep file-label | sed 's/.*file-label = "\(.*\)"\;/Name: /g' | awk '{print "Order: " NR, $0}'
            ;;
        all)
            echo -e "${C_HIL}Exporting all ...${C_RES}\n"
            # @TODO: Run all exports

            ;;
        *)
            echo -e "${C_ERR}Invalid playbook: ${C_WAR}$PLAYBOOK${C_RES}"
            echo -e "${C_SUC}Available options:${C_RES}" \
                "01-config 02-cli 03-apps 04-packages"   \
                "05-repos 06-os 07-cloud 08-prefs"
            exit 1
            ;;
    esac

    # @TODO: Push Saved Exported
}

# Update env-setup
update() {
    cd "$INSTALL_DIR"

    if [[ -f config.yml ]]; then
        ANSIBLE_EXTRA_VARS="-e @config.yml"
    else
        ANSIBLE_EXTRA_VARS="-e @default.config.yml"
    fi

    ENVSETUP_DIR=$(pwd)
    # shellcheck disable=SC2086
    PUB_DOTFILES_DIR=$(ansible -m shell                                    \
        -a "echo {{ pub_dotfiles_repo_local_destination }}" -t tmp         \
        localhost $ANSIBLE_EXTRA_VARS 2> /dev/null | cut -d'>' -f3 | xargs \
        || true)
    # shellcheck disable=SC2086
    PRV_DOTFILES_DIR=$(ansible -m shell                                    \
        -a "echo {{ prv_dotfiles_repo_local_destination }}" -t tmp         \
        localhost $ANSIBLE_EXTRA_VARS 2> /dev/null | cut -d'>' -f3 | xargs \
        || true)
    rm "tmp/localhost"

    while read -r DOTFILE_PATH; do
        REPO="$(basename "${DOTFILE_PATH/'~'/$HOME}")"
        echo -e "\n${C_HIL}Updating $REPO...${C_RES}"
        cd "${DOTFILE_PATH/'~'/$HOME}"

        GIT_STASH="env-setup-update-$(date +%s)"
        git stash -m "$GIT_STASH"
        git pull --rebase
        # shellcheck disable=SC1083
        git stash apply stash^{/"$GIT_STASH"} 2> /dev/null || true
        git stash drop 0 2> /dev/null || true
    done < <(echo -e "$ENVSETUP_DIR\n$PUB_DOTFILES_DIR\n$PRV_DOTFILES_DIR")
}

# Run env-setup playbook
run_playbook() {
    PLAYBOOK_NAME=${1:-""}
    PLAYBOOK_DIR=${2:-""}

    if [[ -d "$PLAYBOOK_DIR" ]]; then
        if [[ -z "$ANSIBLE_PLAYBOOK_INFO" ]]; then
            echo -e "\n${C_HIL}Run $PLAYBOOK_NAME playbook...${C_RES}"
        else
            echo -e "\n${C_HIL}Show $PLAYBOOK_NAME playbook tasks...${C_RES}"
        fi
        PWD=$(pwd)
        cd "$PLAYBOOK_DIR"

        if [[ -f requirements.yml ]]; then
            # shellcheck disable=SC2086
            ansible-galaxy install $ANSIBLE_VERBOSE -r requirements.yml
        fi
        if [[ "$ANSIBLE_SUDO" == "-K" ]]; then
            echo -e "\n${C_WAR}Enter password for install permissions${C_RES}"
        else
            ANSIBLE_SUDO=""
        fi
        if [[ -f ../../../config.yml ]]; then
            ANSIBLE_EXTRA_VARS="-e @../../../config.yml"
        else
            ANSIBLE_EXTRA_VARS=""
        fi

        ANSIBLE_TAG_FLAGS=""
        if [[ -n "$ANSIBLE_SKIPPED_TAGS" ]]; then
            ANSIBLE_TAG_FLAGS="--skip-tags $ANSIBLE_SKIPPED_TAGS"
        fi
        if [[ -n "$ANSIBLE_TAGS" ]]; then
            ANSIBLE_TAG_FLAGS="--tags $ANSIBLE_TAGS"
        fi

        # shellcheck disable=SC2086
        ansible-playbook main.yml $ANSIBLE_VERBOSE $ANSIBLE_CHECK \
            $ANSIBLE_TAG_FLAGS                                    \
            -i inventory $ANSIBLE_SUDO                            \
            $ANSIBLE_EXTRA_VARS                                   \
            $ANSIBLE_PLAYBOOK_INFO
        cd "$PWD"
        echo -e "\n${C_SUC}$PLAYBOOK_NAME playbook completed!${C_RES}"
    else
        echo -e "\n${C_ERR}Could not find the $PLAYBOOK_NAME playbook!${C_RES}"
        exit 1
    fi
}

##}}}#######################################################################


#/ Usage: $SCRIPT [PLAYBOOK]
#/
#/
#/   <PLAYBOOK>: An optional playbook name for env-setup to run.
#/
#/ Examples:
#/
#/   $SCRIPT
#/      Start $SCRIPT to select playbooks to setup.
#/   $SCRIPT -A
#/      Generate aliases to be sourced with "eval "$(env-setup -A)
#/   $SCRIPT -c
#/      Set a new config.
#/   $SCRIPT -C 02-cli
#/      Run "02-cli" playbook as a "dry-run". (--check)
#/   $SCRIPT -i 04-packages
#/      Show "04-packages" playbook tasks.
#/   $SCRIPT -e
#/      Open the custom config.yml for editing via $EDITOR
#/   $SCRIPT -s prv_dotfiles 01-config
#/      Run "01-config" playbook with skipping the prv_dotfiles tasks
#/   $SCRIPT -t pub_dotfiles 01-config
#/      Run "01-config" playbook with only the pub_dotfiles tasks
#/   $SCRIPT -v 03-apps
#/      Run "03-apps" playbook in verbose mode.
#/   $SCRIPT -x 03-apps
#/      Export current 03-apps playbook setup to config.yml
#/   $SCRIPT 04-my-playbook
#/      Have $SCRIPT run the "04-my-playbook" playbook.
#/
#/ Options:
#/   --help/-h: Display this help message
#/          -A: Generate aliases for env-setup tools
#/          -c: Set a new config
#/          -C: Check the changes of the playbook.
#/          -i: Get task info about a playbook.
#/          -e: Open custom config.yml w/ $EDITOR
#/          -s: Run playbook with SKIPPED tags
#/          -t: Run playbook with tags
#/          -u: Update env-setup from its remote Git source
#/          -v: Run env-setup with verbose mode
#/          -x: Export some/all of the current config to config.yml
SCRIPT=$(basename "$0")
SCRIPTS_DIR="$(dirname "$0")"
# shellcheck source=/dev/null
source "$SCRIPTS_DIR/_common"
usage() {
    grep '^#/' "$0" | cut -c4- | sed -e "s/\$SCRIPT/$SCRIPT/g" ; exit 0 ;
}
expr "$*" : ".*--help" > /dev/null && usage

# Handle options
# Add options x: - required arg
while getopts 'AcCheistuvx' FLAG; do
    # shellcheck disable=SC2317
    case "${FLAG}" in

        A)
            echo "alias env-vm-create=\"$INSTALL_DIR/vm/scripts/create\""
            echo "alias env-vm-env-setup=\"$INSTALL_DIR/vm/scripts/env-setup\""
            echo "alias env-vm-init=\"$INSTALL_DIR/vm/scripts/init\""
            echo "alias env-vm-scp=\"$INSTALL_DIR/vm/scripts/scp\""
            echo "alias env-vm-ssh=\"$INSTALL_DIR/vm/scripts/ssh\""
            echo "alias env-vm-start=\"$INSTALL_DIR/vm/scripts/start\""
            echo "alias env-vm-stop=\"$INSTALL_DIR/vm/scripts/stop\""
            exit 0
            shift "$((OPTIND-1))"
            ;;

        c)
            shift "$((OPTIND-1))"
            config "${1:-""}"
            exit 0
            ;;

        C)
            ANSIBLE_CHECK="-C"
            shift "$((OPTIND-1))"
            ;;

        h)
            usage;
            exit 0
            ;;

        e)
            $EDITOR "$ENVSETUP_DIR/config.yml"
            echo -e "${C_SUC}Updated ${C_WAR}$ENVSETUP_DIR/config.yml${C_RES}"
            exit 0
            ;;

        i)
            ANSIBLE_PLAYBOOK_INFO="--list-tasks"
            shift "$((OPTIND-1))"
            ;;

        s)
            shift "$((OPTIND-1))"
            ANSIBLE_SKIPPED_TAGS="$1"
            shift "$((OPTIND-1))"
            ;;

        t)
            shift "$((OPTIND-1))"
            ANSIBLE_TAGS="$1"
            shift "$((OPTIND-1))"
            ;;

        u)
            update
            exit 0
            ;;

        v)
            set -vx
            ANSIBLE_VERBOSE="-vvv"
            ANSIBLE_STDOUT_CALLBACK="debug"
            shift "$((OPTIND-1))"
            ;;

        x)
            shift "$((OPTIND-1))"
            xport "${1:-""}"
            exit 0
            ;;

        *) : ;;
    esac
done

############################################################################
# VARS
############################################################################
ANSIBLE_SUDO=${ANSIBLE_SUDO:-"-K"}
ANSIBLE_CHECK=${ANSIBLE_CHECK:-""}
ANSIBLE_PLAYBOOK_INFO=${ANSIBLE_PLAYBOOK_INFO:-""}
ANSIBLE_SKIPPED_TAGS=${ANSIBLE_SKIPPED_TAGS:-""}
ANSIBLE_TAGS=${ANSIBLE_TAGS:-""}
ANSIBLE_VERBOSE=${ANSIBLE_VERBOSE:-""}
# unixy | dense | debug | yaml | selective
export ANSIBLE_STDOUT_CALLBACK=${ANSIBLE_STDOUT_CALLBACK:-"unixy"}
export ANSIBLE_ROLES_PATH="$HOME/.ansible/roles"
ENVSETUP_SELECT_MSG="Select an env-setup playbook (enter q to quit):"
INIT_PLAYBOOK=".00-init"
PY_VER=$(python3 -m site --user-site | cut -d'/' -f6)
export PATH="$HOME/Library/Python/$PY_VER/bin:/usr/local/bin:$PATH"
PLAYBOOK=${1:-""}

############################################################################
# MAIN
############################################################################

SUGGEST_ANSIBLE=$(if [[ -x "$(command -v ansible)" ]]; then \
    echo "0"; else echo "${ENVSETUP_SUGGEST_ANSIBLE:-1}"; fi)
if [[ $SUGGEST_ANSIBLE == "1" ]]; then
    echo -e "To begin we'll need to...\n"
    if [[ $ENVSETUP_OS =~ "darwin"* ]]; then
        SUGGEST_PIP=$(if [[ "$(python3 -m pip -V 2> /dev/null)" ]]; then \
            echo "0"; else echo "${ENVSETUP_SUGGEST_PIP:-1}"; fi)
        if [[ $SUGGEST_PIP == "1" ]]; then
            echo -e "[ ] install Pip"
        fi
    fi
    echo -e "[ ] install Ansible"
    if [[ $ENVSETUP_INTERACT == "1" ]]; then
        read -r -p "Continue? (yes/no): " ANSWER
        [[ $ANSWER == "yes" ]] || exit 0
        echo -e "\n"
    fi
fi

case "$ENVSETUP_OS" in
    darwin*)
        if [[ $SUGGEST_ANSIBLE == "1" ]]; then
            "$SCRIPTS_DIR/macos/install-ansible"
        fi
        ABSOLUTE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" \
            && pwd)/$(basename "${BASH_SOURCE[0]}")"
        PLAYBOOKS="$(dirname "$(dirname "$ABSOLUTE_PATH")")/ansible/macos"
        ;;
    linux*)
        if [[ $SUGGEST_ANSIBLE == "1" ]]; then
            "$SCRIPTS_DIR/linux/install-ansible"
        fi
        PLAYBOOKS="$(dirname "$(realpath "$SCRIPTS_DIR")")/ansible/linux"
        ;;
    *)
        echo -e "${C_WAR}Unsupported OS${C_RES}\n"
        exit 1
        ;;
esac

if [[ ! -f "$PLAYBOOKS/$INIT_PLAYBOOK/.init" ]]; then
    run_playbook "Initial" "$PLAYBOOKS/$INIT_PLAYBOOK"
fi

if [[ -z "$PLAYBOOK" ]]; then
    echo -e "${C_SUC}$ENVSETUP_SELECT_MSG${C_RES}\n"
    # shellcheck disable=SC2116,SC2046
    # ls -d /home/ubuntu/env-setup/ansible/linux/* | xargs -n1 basename
    OPTIONS=$(find "$PLAYBOOKS/"* -type d -print0 | xargs -0 -n1 basename)
    select PLAYBOOK in $OPTIONS; do
        if [[ "$PLAYBOOK" == "" ]]; then
            echo -e "${C_WAR}Quit${C_RES}\n"
            exit 0
        else
            run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
            echo -e "\n${C_SUC}$PLAYBOOK completed!${C_RES}"
            exit 0
        fi
    done
    echo -e "${C_SUC}$ENVSETUP_SELECT_MSG${C_RES}\n"
else
    if [[ "$PLAYBOOK" == "all" ]]; then
        echo -e "${C_SUC}Running all playbooks:${C_RES}\n"
        OPTIONS=$(find "$PLAYBOOKS/"* -type d -print0 | xargs -0 -n1 basename)
        for PLAYBOOK in $OPTIONS; do
            run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
        done
    else
        run_playbook "$PLAYBOOK" "$PLAYBOOKS/$PLAYBOOK"
    fi
fi
